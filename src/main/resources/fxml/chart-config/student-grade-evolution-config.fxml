<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox spacing="10" xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      styleClass="main-container">
   
    <Label text="Configuration de l'évolution des notes" styleClass="section-title"/>
   
    <GridPane hgap="10" vgap="10" styleClass="form-grid">
        <padding><Insets top="10" bottom="10"/></padding>
       
        <columnConstraints>
            <ColumnConstraints hgrow="NEVER" minWidth="100"/>
            <ColumnConstraints hgrow="ALWAYS"/>
        </columnConstraints>
       
        <Label text="Étudiant:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <ComboBox fx:id="studentComboBox" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
       
        <Label text="Matière:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <ComboBox fx:id="subjectComboBox" prefWidth="200" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
       
        <Label text="Période:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <HBox spacing="10" GridPane.columnIndex="1" GridPane.rowIndex="2">
            <ComboBox fx:id="periodComboBox" prefWidth="200">
                <items>
                    <FXCollections fx:factory="observableArrayList">
                        <String fx:value="Année entière"/>
                        <String fx:value="Premier trimestre"/>
                        <String fx:value="Deuxième trimestre"/>
                        <String fx:value="Troisième trimestre"/>
                    </FXCollections>
                </items>
            </ComboBox>
        </HBox>
    </GridPane>
   
    <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="button-container">
        <Button fx:id="cancelButton" text="J'annule" />
        <Button fx:id="applyButton" text="J'applique" />
    </HBox>
</VBox>